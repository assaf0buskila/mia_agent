#!/usr/bin/env bash
# Mia's control script on the VM. `mia deploy` installs it to /usr/local/bin/mia.
# Run as root: sudo mia <command>
set -euo pipefail

usage() {
  cat <<'EOF'
usage: sudo mia <command>
  deploy <tag> [sha]    build /opt/mia/src/<tag>, fetch settings, migrate, restart
  settings              re-fetch settings from Secret Manager and restart
  https enable|disable|status
                        serve mia.assafweb.com through Caddy (after DNS points here)
  jobs pause|resume|status
                        scheduled jobs (due-scan every 15 min, knowledge ingest hourly)
  job <name>            run one job now: mia-due-scan | mia-ingest-knowledge
  os-ledger migrate --approved-sha <sha>
                        explicitly apply ledger schema after owner go and V2-14a
  telegram-webhook      register https://<public url>/v1/telegram/webhook with Telegram
  go-live               after DNS points here: https enable, jobs resume, webhook, first ingest
  restore <dump>        replace the database with a pg_dump custom-format file, give the
                        roles their ownership and grants back, and only then start the services.
                        It pauses the jobs first; resume them with `jobs resume` once ready
  backup               write a database dump to /var/lib/mia/backups
  status                containers, health and timers
  logs [service]        follow logs (postgres, migrate, app, caddy)
EOF
}

die() { echo "mia: $*" >&2; exit 1; }
https_marker="${MIA_HTTPS_MARKER:-/etc/mia/https-enabled}"
jobs_paused="${MIA_JOBS_PAUSED:-/etc/mia/jobs-paused}"
jobs=(mia-due-scan mia-ingest-knowledge)
# Every dump leaves the personal statement line detail out (FORK-BACKUP). A restored pending
# batch has no lines, and the first os-retention run finishes it as `restored_without_detail`.
dump_exclude=(--exclude-table-data=assaf_os.os_statement_batch_lines)

compose() {
  local profile=()
  [ ! -f "$https_marker" ] || profile=(--profile https)
  docker compose -p mia -f /opt/mia/compose.yaml --env-file /opt/mia/tag.env "${profile[@]}" "$@"
}

# Settings owned by the VM are dropped from the uploaded secret.
fetch_settings() {
  python3 - <<'PY'
import base64, json, os, re, sys, urllib.error, urllib.request

def metadata(path):
    request = urllib.request.Request(
        "http://metadata.google.internal/computeMetadata/v1/" + path,
        headers={"Metadata-Flavor": "Google"},
    )
    return urllib.request.urlopen(request, timeout=10).read().decode()

project = metadata("project/project-id")
token = json.loads(metadata("instance/service-accounts/default/token"))["access_token"]
request = urllib.request.Request(
    f"https://secretmanager.googleapis.com/v1/projects/{project}/secrets/mia-env/versions/latest:access",
    headers={"Authorization": f"Bearer {token}"},
)
try:
    response = urllib.request.urlopen(request, timeout=20)
except urllib.error.HTTPError as error:
    sys.exit(f"mia: cannot read secret mia-env (HTTP {error.code}); run ops/gcp/push-settings.ps1")
data = json.loads(response.read())["payload"]["data"]
# VM-owned names never come from mia-env: the ledger DSNs and the posture live in the VM-owned
# /etc/mia/runtime.env and /etc/mia/os-ledger-migrate.env. Only the ledger family is owned here
# (MIA_OWNER_OS_LEDGER_*, MIA_OS_LEDGER_*, MIA_APP_ROLE_POSTURE). The rest of MIA_OWNER_OS_*
# (the enable flags, the Google keys, the session secret and DSN that provision_auth.py wrote into
# mia-env) stays settable from mia-env and must not be added to this pattern.
owned = re.compile(r"^(MIA_DATABASE_URL|POSTGRES_\w+|PG\w+|MIA_OWNER_OS_LEDGER_\w+|MIA_OS_LEDGER_\w+|MIA_APP_ROLE_POSTURE)\s*=")
assignment = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
lines = []
for raw in base64.b64decode(data).decode("utf-8").splitlines():
    line = re.sub(r"^\s*export\s+", "", raw)
    match = assignment.match(line)
    if not match or owned.match(line):
        continue
    name, value = match.groups()
    # Compose interpolates ${...} in env files; single quotes keep a value literal.
    if "$" in value:
        value = f"'{value}'" if "'" not in value else value.replace("$", "$$")
    lines.append(f"{name}={value}")
temporary = "/etc/mia/settings.env.tmp"
with os.fdopen(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as file:
    file.write("\n".join(lines) + "\n")
os.replace(temporary, "/etc/mia/settings.env")
print(f"mia: {len(lines)} settings loaded")
PY
}

wait_healthy() {
  local service="$1" id state
  for _ in $(seq 60); do
    id="$(compose ps -q "$service")"
    state="$([ -n "$id" ] && docker inspect -f '{{.State.Health.Status}}' "$id" 2>/dev/null || true)"
    [ "$state" = healthy ] && return 0
    sleep 2
  done
  die "$service did not become healthy"
}

start_services() {
  compose up -d --remove-orphans postgres migrate app
  wait_healthy app
  if [ -f "$https_marker" ]; then
    compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
    compose up -d --force-recreate caddy
  fi
}

install_timers() {
  cat > /etc/systemd/system/mia-job@.service <<'EOF'
[Unit]
Description=Mia scheduled job %i
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mia job %i
TimeoutStartSec=20min
EOF
  cat > /etc/systemd/system/mia-due-scan.timer <<'EOF'
[Unit]
Description=Mia owner-task reminders, every 15 minutes

[Timer]
OnCalendar=*:0/15
Unit=mia-job@mia-due-scan.service

[Install]
WantedBy=timers.target
EOF
  cat > /etc/systemd/system/mia-ingest-knowledge.timer <<'EOF'
[Unit]
Description=Mia re-reads assafweb.com, hourly

[Timer]
OnCalendar=hourly
RandomizedDelaySec=5min
Unit=mia-job@mia-ingest-knowledge.service

[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload
  systemctl enable --now mia-due-scan.timer mia-ingest-knowledge.timer >/dev/null
}

# --- after pg_restore: give the roles back what a restore strips (V2-10) ----------------------
#
# `pg_restore --no-owner --no-privileges` leaves every object owned by mia and every grant gone,
# so mia_app could not read its own tables and assaf_os would lose its owner and its grants.
# `mia restore` runs post_restore_reapply between pg_restore and start_services, under the
# /var/lock/mia-state.lock it already holds, so nothing below may flock that file again. A failure
# prints one fixed reason code and stops with the services DOWN. Every step is idempotent: fix
# the cause and run `mia restore` again. Nothing here prints DSNs, passwords or row data.
# Step 2's provision_ledger.py does print the DDL and GRANT statements it ran, and step 1's
# helper prints one JSON line; neither prints a secret.
app_role_dir=/opt/mia/app-role-demote

restore_note() { echo "mia: post-restore $*"; }

restore_fail() {
  echo "mia: restore stopped, the services stay down: reason=$1" >&2
  exit 1
}

# SQL as the superuser mia (docker exec, unix socket) against one database.
restore_sql() {
  local database="$1"; shift
  compose exec -T postgres psql -X -qAt -v ON_ERROR_STOP=1 -U mia -d "$database" "$@"
}

# Step 1, V2-14a: ownership of every public object and the grants go back to mia_app.
restore_demote_reapply() {
  local exists
  exists="$(restore_sql postgres -c "SELECT 1 FROM pg_roles WHERE rolname='mia_app'")" \
    || restore_fail restore_catalog_unreadable
  if [ "$exists" != 1 ]; then
    restore_note "app_role_reapply skipped reason=app_role_not_demoted"
    return 0
  fi
  [ -f "$app_role_dir/app_role_demote.py" ] && [ -f "$app_role_dir/sql/app-role-demote.sql" ] \
    || restore_fail app_role_reapply_unavailable
  # Called directly, never through app-role-demote.sh: this process holds the state lock and the
  # wrapper's flock -n on the same file would report it busy.
  python3 "$app_role_dir/app_role_demote.py" --reapply || restore_fail app_role_reapply_failed
  restore_note "app_role_reapply ok"
}

# Step 2, V2-15: assaf_os gets its owner, its revokes and its exact grants back. The script is
# the one deployed with the running image, mounted into that image, run as root because it reads
# /etc/mia/runtime.env. /etc/mia is mounted READ-ONLY: a restore never writes a VM-owned file. A
# ledger runtime role that is missing (a fresh cluster) is therefore created only from a DSN that
# is already staged in runtime.env; with nothing staged the script refuses before it creates
# anything and the restore stops: provision it explicitly first (provision_ledger.py --mode
# provision, per the runbook). A database without assaf_os has nothing to repair.
restore_ledger_reapply() {
  local present tag script
  present="$(restore_sql mia -c "SELECT to_regnamespace('assaf_os') IS NOT NULL")" \
    || restore_fail restore_catalog_unreadable
  if [ "$present" != t ]; then
    restore_note "ledger_reapply skipped reason=ledger_schema_absent"
    return 0
  fi
  tag="$(sed -n 's/^MIA_TAG=//p' /opt/mia/tag.env)"
  [[ "$tag" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || restore_fail ledger_reapply_unavailable
  script="/opt/mia/src/$tag/ops/assaf-os/provision_ledger.py"
  [ -f "$script" ] && [ ! -L "$script" ] || restore_fail ledger_reapply_unavailable
  [ -f /etc/mia/os-ledger-migrate.env ] || restore_fail ledger_reapply_unavailable
  # The same key check `mia os-ledger` makes: compose must not read any other key from this file.
  awk '
      /^[[:space:]]*(#|$)/ { next }
      !/^MIA_OS_LEDGER_MIGRATION_DATABASE_URL=('\''[^'\'']*'\''|"[^"]*"|[^[:space:]'\''"]+)[[:space:]]*$/ { exit 1 }
    ' /etc/mia/os-ledger-migrate.env || restore_fail ledger_reapply_unavailable
  compose --profile os-ledger run --rm --no-deps -T --user root \
    -v "$script:/app/ops/assaf-os/provision_ledger.py:ro" -v /etc/mia:/etc/mia:ro \
    --entrypoint sh os-ledger-migrate \
    -c 'exec python /app/ops/assaf-os/provision_ledger.py --target mia-vm --mode reapply --apply --approved-sha "$MIA_BUILD_SHA"' \
    || restore_fail ledger_reapply_failed
  restore_note "ledger_reapply ok"
}

# The main DSN's role and password, from the VM-owned runtime.env. Only the canonical loopback
# form V2-14a and bootstrap write is accepted. The password lives in a shell variable until it is
# piped to the probe on stdin; it is never an argument and never printed.
restore_read_main_dsn() {
  local count line
  count="$(grep -c '^MIA_DATABASE_URL=' /etc/mia/runtime.env 2>/dev/null)" || true
  [ "$count" = 1 ] || restore_fail main_dsn_invalid
  line="$(grep '^MIA_DATABASE_URL=' /etc/mia/runtime.env)"
  [[ "$line" =~ ^MIA_DATABASE_URL=postgresql://([a-z_][a-z0-9_]*):([0-9a-f]+)@127\.0\.0\.1:5432/mia$ ]] \
    || restore_fail main_dsn_invalid
  main_role="${BASH_REMATCH[1]}"
  main_password="${BASH_REMATCH[2]}"
}

# Step 3: V2-14's own posture validator, run for real in the deployed image on the real main DSN.
# Only once the main DSN is the demoted role: before the cutover it is still the superuser mia.
# It proves the role's catalog posture, not its password: while the cluster's loopback pg_hba
# line is `trust` (the postgres image's initdb default, ahead of POSTGRES_HOST_AUTH_METHOD), a
# wrong password still connects. Closing that line is ops/gcp/vm/pg-hba-harden.sh (E21), step 1a of
# docs/runbooks/APP_ROLE_DEMOTE.md; new clusters get scram from initdb (compose.yaml, bootstrap.sh).
restore_main_role_validate() {
  restore_read_main_dsn
  unset main_password
  if [ "$main_role" != mia_app ]; then
    restore_note "main_role_validation skipped reason=main_dsn_not_demoted"
    return 0
  fi
  local check
  IFS= read -r -d '' check <<'PY' || true
import os

from sqlalchemy import create_engine, text

from app.db.os_ledger_migrate import _validate_main_role_catalog
from app.db.session import sqlalchemy_database_url

engine = create_engine(
    sqlalchemy_database_url(os.environ["MIA_DATABASE_URL"]), connect_args={"connect_timeout": 10}
)
with engine.connect() as conn:
    if not conn.scalar(text("SELECT session_user = current_user AND current_user = 'mia_app'")):
        raise SystemExit(1)
    _validate_main_role_catalog(conn, "mia_app")
PY
  compose run --rm --no-deps -T --entrypoint python app -c "$check" >/dev/null 2>&1 \
    || restore_fail main_role_validation_failed
  restore_note "main_role_validation ok"
}

# Step 4: every owner session issued before the restore is revoked. The owner-auth database
# (assaf_os_auth) is not part of this restore, but the data its sessions act on just went back
# in time. Mirrors OwnerSessionStore.revoke_all_for_authenticated_owner for every owner it knows:
# revoked_before moves forward (never back) and the open sessions are closed. Before the owner
# auth exists (no database, no tables) there is no session to revoke: skipped, with the reason.
restore_revoke_owner_sessions() {
  local present tables
  present="$(restore_sql postgres -c "SELECT 1 FROM pg_database WHERE datname='assaf_os_auth'")" \
    || restore_fail owner_session_revoke_failed
  if [ "$present" != 1 ]; then
    restore_note "owner_session_revoke skipped reason=owner_auth_database_absent"
    return 0
  fi
  tables="$(restore_sql assaf_os_auth -c "SELECT count(*) FROM pg_class WHERE relnamespace = 'public'::regnamespace AND relkind = 'r' AND relname IN ('owner_os_sessions', 'owner_os_revocations', 'owner_os_login_proofs')")" \
    || restore_fail owner_session_revoke_failed
  case "$tables" in
    0)
      restore_note "owner_session_revoke skipped reason=owner_auth_tables_absent"
      return 0
      ;;
    3) ;;
    *) restore_fail owner_session_revoke_failed ;;
  esac
  restore_sql assaf_os_auth -1 <<'SQL' || restore_fail owner_session_revoke_failed
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '30s';
INSERT INTO public.owner_os_revocations (owner_id, revoked_before)
SELECT owner_id, now()
FROM (
  SELECT owner_id FROM public.owner_os_sessions
  UNION SELECT owner_id FROM public.owner_os_login_proofs
  UNION SELECT owner_id FROM public.owner_os_revocations
) AS owners
ON CONFLICT (owner_id) DO UPDATE
SET revoked_before = GREATEST(public.owner_os_revocations.revoked_before, EXCLUDED.revoked_before);
UPDATE public.owner_os_sessions SET revoked_at = now() WHERE revoked_at IS NULL;
SQL
  restore_note "owner_session_revoke ok"
}

# Step 5: a REAL access probe as the main DSN role. V2-14's posture check does not look at public
# table access, and a restore that was not repaired still passes it while every query is denied.
# SELECT from an application table, then INSERT into it, all rolled back. A row the table itself
# refuses (class 23: NOT NULL, key, check) means the privilege check already passed. Any other
# error, such as permission denied, fails the probe. The password goes over stdin, but it proves
# privileges, not authentication: under a `trust` loopback pg_hba line the server never checks it.
restore_access_probe() {
  restore_read_main_dsn
  local probe
  IFS= read -r -d '' probe <<'SQL' || true
BEGIN;
SET LOCAL statement_timeout = '30s';
DO $probe$
DECLARE target text;
BEGIN
  SELECT quote_ident(c.relname) INTO target FROM pg_class c
  WHERE c.relnamespace = 'public'::regnamespace AND c.relkind = 'r'
    AND NOT EXISTS (SELECT 1 FROM pg_trigger t WHERE t.tgrelid = c.oid AND NOT t.tgisinternal)
  ORDER BY c.relname LIMIT 1;
  IF target IS NULL THEN
    RAISE EXCEPTION 'no application table to probe';
  END IF;
  EXECUTE format('SELECT 1 FROM public.%s LIMIT 1', target);
  BEGIN
    EXECUTE format('INSERT INTO public.%s DEFAULT VALUES', target);
  EXCEPTION WHEN integrity_constraint_violation THEN
    NULL;
  END;
END
$probe$;
ROLLBACK;
SQL
  printf '%s\n' "$main_password" | compose exec -T postgres sh -c \
    'IFS= read -r PGPASSWORD; export PGPASSWORD; exec psql -X -qAt -v ON_ERROR_STOP=1 -h 127.0.0.1 -U "$1" -d mia -c "$2"' \
    sh "$main_role" "$probe" >/dev/null 2>&1 \
    || { unset main_password; restore_fail app_role_access_probe_failed; }
  unset main_password
  restore_note "access_probe ok role=$main_role"
}

post_restore_reapply() {
  set +x
  restore_demote_reapply
  restore_ledger_reapply
  restore_main_role_validate
  restore_revoke_owner_sessions
  restore_access_probe
  restore_note "complete"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  deploy|settings|https|restore|go-live|os-ledger)
    exec 9>/var/lock/mia-state.lock
    flock -n 9 || die "another Mia operation is already running"
    ;;
esac

case "$cmd" in
  deploy)
    tag="${1:?usage: mia deploy <tag> [sha]}"
    sha="${2:-$tag}"
    src="/opt/mia/src/$tag"
    [ -f /var/lib/mia/.bootstrap-done ] || die "VM bootstrap has not finished; retry in a minute"
    [ -d "$src" ] || die "missing $src"
    # A brand-new VM starts with jobs paused so it cannot double-send while AWS is live.
    [ -f /opt/mia/tag.env ] || touch "$jobs_paused"
    install -m 755 "$src/ops/gcp/vm/mia" /usr/local/bin/mia
    install -m 644 "$src/ops/gcp/vm/compose.yaml" /opt/mia/compose.yaml
    install -m 644 "$src/ops/gcp/vm/Caddyfile" /opt/mia/Caddyfile
    docker build --progress=plain --build-arg "MIA_BUILD_SHA=$sha" \
      -f "$src/deploy/Dockerfile" -t "mia:$tag" "$src"
    fetch_settings
    printf 'MIA_TAG=%s\n' "$tag" > /opt/mia/tag.env
    start_services
    install_timers
    # Keep the three newest sources and their images.
    for old in $(ls -1t /opt/mia/src | tail -n +4); do
      rm -rf "/opt/mia/src/$old"
      docker image rm "mia:$old" >/dev/null 2>&1 || true
    done
    docker image prune -f >/dev/null
    docker builder prune -f --filter until=168h >/dev/null 2>&1 || true
    compose ps
    ;;
  settings)
    fetch_settings
    start_services
    ;;
  https)
    case "${1:-status}" in
      enable)  install -m 600 /dev/null "$https_marker"; start_services ;;
      disable) rm -f "$https_marker"; docker compose -p mia -f /opt/mia/compose.yaml --env-file /opt/mia/tag.env stop caddy ;;
      status)  if [ -f "$https_marker" ]; then echo enabled; else echo disabled; fi ;;
      *) die "usage: mia https enable|disable|status" ;;
    esac
    ;;
  jobs)
    case "${1:-status}" in
      pause)  install -m 600 /dev/null "$jobs_paused"; echo paused ;;
      resume) rm -f "$jobs_paused"; echo resumed ;;
      status)
        if [ -f "$jobs_paused" ]; then echo paused; else echo running; fi
        systemctl list-timers 'mia-*' --no-pager || true
        ;;
      *) die "usage: mia jobs pause|resume|status" ;;
    esac
    ;;
  job)
    name="${1:?usage: mia job <name>}"
    printf '%s\n' "${jobs[@]}" | grep -qx "$name" || die "unknown job: $name"
    [ -f /opt/mia/tag.env ] || die "not deployed yet"
    if [ -f "$jobs_paused" ]; then echo "mia: jobs are paused; skipping $name"; exit 0; fi
    exec 8>"/var/lock/mia-job-$name.lock"
    flock -n 8 || { echo "mia: $name is already running"; exit 0; }
    compose run --rm --no-deps -T app "$name"
    ;;
  os-ledger)
    [ "$#" -eq 3 ] && [ "$1" = migrate ] && [ "$2" = --approved-sha ] \
      || die "usage: mia os-ledger migrate --approved-sha <sha>"
    [[ "$3" =~ ^[0-9a-f]{40}$ ]] || die "exact approved SHA required"
    [ -f /opt/mia/tag.env ] || die "not deployed yet"
    [ -f /etc/mia/os-ledger-migrate.env ] || die "ledger migration env file required"
    # Refuse other keys before Compose can substitute the main DSN or approval SHA.
    # Keep this file single-line-per-value; multiline values fail closed too.
    awk '
      /^[[:space:]]*(#|$)/ { next }
      !/^MIA_OS_LEDGER_MIGRATION_DATABASE_URL=('\''[^'\'']*'\''|"[^"]*"|[^[:space:]'\''"]+)[[:space:]]*$/ { exit 1 }
    ' /etc/mia/os-ledger-migrate.env || die "ledger migration env keys refused"
    compose --profile os-ledger run --rm --no-deps -T os-ledger-migrate "$@"
    ;;
  telegram-webhook)
    compose run --rm --no-deps -T app mia-telegram-webhook
    ;;
  go-live)
    [ -f /opt/mia/tag.env ] || die "deploy first"
    install -m 600 /dev/null "$https_marker"
    start_services
    for _ in $(seq 30); do
      curl -fsS -o /dev/null --max-time 5 "https://mia.assafweb.com/health/live" && break
      sleep 5
    done
    curl -fsS --max-time 10 "https://mia.assafweb.com/health/ready" >/dev/null \
      || die "https://mia.assafweb.com is not ready yet (DNS or certificate); retry in a few minutes"
    rm -f "$jobs_paused"
    compose run --rm --no-deps -T app mia-telegram-webhook
    compose run --rm --no-deps -T app mia-ingest-knowledge
    echo "mia: live on https://mia.assafweb.com"
    ;;
  restore)
    file="${1:?usage: mia restore <dump file>}"
    [ -s "$file" ] || die "missing or empty dump: $file"
    [ -f /opt/mia/tag.env ] || die "deploy once before restoring"
    # A job timer that fires while the database is dropped, half restored or half repaired would
    # touch it: `mia job` takes no state lock. Pause the jobs now; they stay paused until the
    # operator has checked readiness and resumes them, also after a post-step abort.
    install -m 600 /dev/null "$jobs_paused"
    echo "mia: jobs are paused for the restore; after readiness run: sudo mia jobs resume"
    compose stop caddy app >/dev/null 2>&1 || true
    compose up -d postgres
    wait_healthy postgres
    if compose exec -T postgres psql -U mia -d mia -tAc "select count(*) from information_schema.tables where table_schema='public'" 2>/dev/null | grep -qv '^0$'; then
      safety="/var/lib/mia/backups/pre-restore-$(date -u +%Y%m%dT%H%M%SZ).dump"
      compose exec -T postgres pg_dump -U mia -d mia --format=custom "${dump_exclude[@]}" > "$safety"
      chmod 600 "$safety"
      echo "mia: existing database saved to $safety"
    fi
    compose exec -T postgres psql -U mia -d postgres -v ON_ERROR_STOP=1 \
      -c "DROP DATABASE IF EXISTS mia WITH (FORCE)" -c "CREATE DATABASE mia OWNER mia"
    compose exec -T postgres pg_restore -U mia -d mia --no-owner --no-privileges --exit-on-error < "$file"
    echo "mia: restored $(compose exec -T postgres psql -U mia -d mia -tAc "select count(*) from information_schema.tables where table_schema='public'") tables"
    # Roles and grants come back BEFORE anything can reach the database. Any failure stops here.
    post_restore_reapply
    start_services
    ;;
  backup)
    file="/var/lib/mia/backups/mia-$(date -u +%Y%m%dT%H%M%SZ).dump"
    compose exec -T postgres pg_dump -U mia -d mia --format=custom "${dump_exclude[@]}" > "$file"
    chmod 600 "$file"
    echo "$file"
    ;;
  status)
    compose ps -a
    compose exec -T app python -c \
      "import urllib.request; print(urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=8).read().decode())"
    echo "https: $([ -f "$https_marker" ] && echo enabled || echo disabled)"
    echo "jobs:  $([ -f "$jobs_paused" ] && echo paused || echo running)"
    systemctl list-timers 'mia-*' --no-pager || true
    ;;
  logs)
    compose logs -f --tail 200 "$@"
    ;;
  *)
    usage
    [ -z "$cmd" ] || exit 2
    ;;
esac
