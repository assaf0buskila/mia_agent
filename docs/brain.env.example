# Brain / memory / voice settings — append to .env.example and to .env
#
# I could not edit .env.example directly: this workspace blocks reads and writes on
# .env* (the rule that keeps secrets out of the transcript), and overwriting a file I
# cannot read would risk clobbering it. Append this block yourself:
#
#     cat docs/brain.env.example >> .env.example
#
# `tests/unit/test_deploy_secret_box.py::test_env_example_documents_settings_and_adapter_map`
# fails until every name below appears in .env.example. It is the only failing test in
# this slice that is not pre-existing.
#
# Production secrets live in AWS Secrets Manager `mia/prod`; ECS injects them as MIA_*.
# Only the non-secret names need to change there — the API keys already exist.

# --- Owner agent loop (Telegram) -------------------------------------------
# Empty MIA_OWNER_AGENT_MODEL keeps the deterministic keyword classifier, which is the
# pre-brain behaviour. Set it to turn the tool-calling loop on.
MIA_OWNER_AGENT_MODEL=
MIA_OWNER_AGENT_FALLBACK_MODEL=

# Cross-provider last resort for the owner agent AND memory extraction: the Gemini
# OpenAI-compatibility endpoint. It documents the same nested `tools` shape, so the tool
# loop runs unchanged. Tried only after every OpenAI model above fails with 403/404/410.
# Without it, an OpenAI-side model block drops Telegram back to the keyword classifier
# even though Gemini is connected and already serving website sales.
# Suggested: gemini-3.7-flash
MIA_OWNER_AGENT_GEMINI_MODEL=

MIA_OWNER_AGENT_MAX_STEPS=4

# --- Memory extraction ------------------------------------------------------
# Decides what is worth remembering and reconciles it against existing memory.
# Cheap, high volume: use the least expensive model that supports strict structured output.
MIA_EXTRACTION_MODEL=

# --- Embeddings -------------------------------------------------------------
# `openai` or `gemini`. Never mix vectors from two model families in one corpus: cosine
# across families is meaningless. Changing the model requires a re-embed, not a failover,
# which is why this is explicit rather than automatic.
# MIA_EMBEDDING_DIM must match the model. Leave MIA_EMBEDDING_MODEL empty to run
# keyword-only retrieval with no embedding spend.
MIA_EMBEDDING_PROVIDER=openai
MIA_EMBEDDING_MODEL=
MIA_EMBEDDING_DIM=1536

# --- Memory behaviour -------------------------------------------------------
MIA_MEMORY_ENABLED=true
MIA_MEMORY_WRITE_ENABLED=true
MIA_MEMORY_MAX_CONTEXT_CHARS=4000

# Retrieval weights: relevance + recency + importance, each normalized to [0,1] across the
# candidate set. Relevance leads because Mia answers questions rather than simulating a day.
MIA_MEMORY_WEIGHT_RELEVANCE=1.0
MIA_MEMORY_WEIGHT_RECENCY=0.5
MIA_MEMORY_WEIGHT_IMPORTANCE=0.3

# --- Website knowledge ------------------------------------------------------
# Files fetched from MIA_WEBSITE_URL and indexed. These three are the agent-oriented
# corpus assafweb.com already publishes. Ingest with: uv run mia-ingest-knowledge
MIA_KNOWLEDGE_SOURCES=llms-full.txt,llms.txt,pricing.md

# --- Voice (already present, listed for completeness) -----------------------
# MIA_OPENAI_TRANSCRIBE_MODEL must be a current speech-to-text id. `gpt-transcribe` is the
# recommended default; `whisper-1` is the only model that supports verbose_json.
# MIA_OPENAI_API_KEY, MIA_TELEGRAM_BOT_TOKEN and MIA_OPENAI_TRANSCRIBE_MODEL are all
# required for owner voice notes; GET /health reports exactly which one is missing.

# --- Composio resource discovery (ADR-027) ----------------------------------
# When true, Mia asks Composio which Search Console site / GA4 property / Meta ad
# account the connected account owns, instead of reading MIA_GSC_SITE_URL,
# MIA_GA4_PROPERTY_ID and MIA_META_ADS_ACCOUNT_ID. An explicit env var always wins.
#
# Default false because ports are constructed per request, so enabling this costs one
# network call per process on first use. Verify first:
#     uv run python scripts/probe_composio_discovery.py
# It prints what your account actually returns and whether each id resolves cleanly.
# If a resource is ambiguous (two unrelated sites, two GA4 properties) Mia refuses to
# guess and the port stays disabled — set the env var explicitly in that case.
#
# Not removable: MIA_LINKEDIN_ACCESS_TOKEN (Composio's LinkedIn toolkit has no
# member-level post analytics, only organization stats) and MIA_SHEETS_SPREADSHEET_ID
# (the Sheets mirror is a write target; auto-picking one is how you scribble on the
# wrong document).
MIA_COMPOSIO_DISCOVERY=false
