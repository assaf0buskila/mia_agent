{
  "Rule": "mia-db-password-rotated",
  "Targets": [
    {
      "Id": "mia-db-password-sync-lambda",
      "Arn": "arn:aws:lambda:REGION:ACCOUNT_ID:function:mia-db-password-sync",
      "RetryPolicy": {
        "MaximumEventAgeInSeconds": 3600,
        "MaximumRetryAttempts": 2
      }
    }
  ]
}
