{
  "AlarmName": "mia-db-password-sync-errors",
  "AlarmDescription": "Chunk C9: mia-db-password-sync Lambda raised. A failed sync means mia/prod can silently go stale again -- page the same SNS topic the Lambda's own DLQ delivers to.",
  "Namespace": "AWS/Lambda",
  "MetricName": "Errors",
  "Dimensions": [
    { "Name": "FunctionName", "Value": "mia-db-password-sync" }
  ],
  "Statistic": "Sum",
  "Period": 300,
  "EvaluationPeriods": 1,
  "DatapointsToAlarm": 1,
  "Threshold": 0,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "notBreaching",
  "AlarmActions": ["arn:aws:sns:REGION:ACCOUNT_ID:mia-db-password-sync-alerts"]
}
