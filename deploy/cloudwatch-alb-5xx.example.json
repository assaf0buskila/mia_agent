{
  "AlarmName": "mia-alb-elb-5xx",
  "AlarmDescription": "Mia ALB HTTPCode_ELB_5XX_Count. Pages SNS when MIA_ALB_5XX_SNS_TOPIC_ARN is stamped.",
  "Namespace": "AWS/ApplicationELB",
  "MetricName": "HTTPCode_ELB_5XX_Count",
  "Dimensions": [
    { "Name": "LoadBalancer", "Value": "app/mia/HASH" }
  ],
  "Statistic": "Sum",
  "Period": 60,
  "EvaluationPeriods": 2,
  "DatapointsToAlarm": 2,
  "Threshold": 0,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "notBreaching",
  "AlarmActions": ["arn:aws:sns:REGION:ACCOUNT_ID:mia-alb-5xx"]
}
