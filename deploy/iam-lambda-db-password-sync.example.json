{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRdsManagedPassword",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:rds!db-d7c051e7-2f6a-4711-826d-2bf7d243a2f8-gjs5XD*"
    },
    {
      "Sid": "ReadAndRewriteMiaProdBoxOnly",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:mia/prod*"
    },
    {
      "Sid": "ForceMiaServiceRedeploy",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:REGION:ACCOUNT_ID:service/mia/mia"
    }
  ]
}
