{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunMiaTaskOnMiaCluster",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:REGION:ACCOUNT_ID:task-definition/mia:*",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:REGION:ACCOUNT_ID:cluster/mia"
        }
      }
    },
    {
      "Sid": "PassMiaTaskRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/miaTaskExecutionRole",
        "arn:aws:iam::ACCOUNT_ID:role/miaTaskRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
