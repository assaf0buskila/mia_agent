# Laptop .env only. Never commit .env. Never paste keys in chat.
# Production SECRET keys go in AWS Secrets Manager mia/prod (ADR-014).
# ECS injects JSON keys as MIA_* at task start. Do not copy this file onto Fargate.
# Adapter map: docs/DECISIONS.md ADR-015. Go-live: docs/PRODUCTION_BUILD.md
# Map: docs/PRODUCT.md
# Tests ignore this file (tests/conftest.py).
#
# EDIT     = replace (blank or REPLACE_…)
# KEEP     = first-live value — do not flip unless Assaf changes policy
# SECRET   = box (prod) or local .env (laptop)
# Landing-page Vercel NEXT_PUBLIC_MIA_BASE_URL = https://mia.assafweb.com
#
# ADR-015: LangGraph brain, Postgres SoR.
# WhatsApp inbound = Meta webhook, always — never Composio. Outbound send has exactly ONE owner, selected by MIA_WHATSAPP_SENDER: direct = Meta Graph, composio = WHATSAPP_SEND_MESSAGE. Never dual-send (ADR-016). Production is composio.
# Gmail/Calendar/Sheets/LinkedIn profile = Composio.
# Research = Firecrawl primary; Apify google-search-scraper fallback when Firecrawl is empty (ADR-035).

# --- runtime (KEEP) ---
MIA_ENV=prod
MIA_DEMO_MODE=false
MIA_LOG_LEVEL=INFO
MIA_APP_NAME=mia
MIA_WEBSITE_URL=https://www.assafweb.com

# EDIT locally — laptop may stay http://127.0.0.1:8000. Production KEEP on ECS is
# https://mia.assafweb.com (ALB+ACM). No trailing slash. Not trycloudflare.
MIA_PUBLIC_BASE_URL=https://REPLACE_WITH_MIA_HTTPS_HOST

# KEEP — production site only.
MIA_CORS_ORIGINS=https://www.assafweb.com,https://assafweb.com

# EDIT — Postgres. sqlite is local-only. Production DSN in the SM box:
# postgres://USER:PASSWORD@HOST:5432/mia?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
MIA_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/mia

# KEEP — live = false. true + new deploy is the emergency stop.
MIA_KILL_SWITCH=false

# Production live test (ADR-022) is auto_approved. Laptop may stay shadow.
MIA_AUTOMATION_MODE=auto_approved
# Unused while automation_mode is auto_approved. Shadow-only WhatsApp handoff bypass.
MIA_WHATSAPP_HANDOFF_SEND=false

# KEEP — production live 2026-08-22: calendar create/PATCH on after Assaf ADOPT.
# Laptop may stay false. R4/R5 are not env knobs.
MIA_CALENDAR_WRITE=true
# Safe default remains false; production may enable only the approval-bound draft-send path.
MIA_GMAIL_SEND=false
MIA_META_WRITE=false
MIA_AUTO_REPLY_INSTAGRAM=false

# --- WhatsApp = Meta Cloud API direct (SECRET) ---
MIA_WHATSAPP_VERIFY_TOKEN=
MIA_WHATSAPP_APP_SECRET=
MIA_WHATSAPP_ACCESS_TOKEN=
MIA_WHATSAPP_PHONE_NUMBER_ID=
MIA_WHATSAPP_GRAPH_VERSION=v25.0
MIA_WHATSAPP_OWNER_PHONES=
MIA_WHATSAPP_CLICK_TO_CHAT=972523393768
# KEEP — one outbound owner. Production is composio after WhatsApp Active on MIA_COMPOSIO_USER_ID.
# Inbound stays Meta webhook (ADR-016). Never dual-send. Graph access token still needed later for media/STT.
MIA_WHATSAPP_SENDER=composio
# KEEP — production true: unknown WhatsApp contacts stay human-only (ADR-017).
# Tests set false in tests/conftest.py so legacy sales-transport cases still run.
MIA_WHATSAPP_REQUIRE_BUSINESS_SCOPE=true

# --- Telegram owner bot (SECRET token+webhook; numeric user ids only) ---
# POST /v1/telegram/webhook. Unauthorized users ignored (HTTP 200). No username auth.
MIA_TELEGRAM_BOT_TOKEN=
MIA_TELEGRAM_WEBHOOK_SECRET=
MIA_TELEGRAM_OWNER_USER_IDS=

# --- OpenAI sales + STT (SECRET keys; KEEP model ids) ---
MIA_OPENAI_API_KEY=
MIA_OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
MIA_OPENAI_TRANSCRIBE_FALLBACK_MODEL=
MIA_SALES_MODEL=gpt-5.6-luna
MIA_SALES_FALLBACK_MODEL=gpt-5.6-luna
MIA_GEMINI_API_KEY=
MIA_SALES_GEMINI_MODEL=gemini-3.6-flash

# --- Instagram inbound = Meta webhook HMAC (SECRET). Default sender stays direct. ---
# Allowlisted senders: direct | composio. One sender per conversation.
# Keep MIA_INSTAGRAM_SENDER=direct until Assaf tests Composio send on staging.
MIA_INSTAGRAM_VERIFY_TOKEN=
MIA_INSTAGRAM_APP_SECRET=
MIA_INSTAGRAM_SENDER=direct
# Graph send/insights tokens — still used while sender=direct (ADR-015).
MIA_INSTAGRAM_ACCESS_TOKEN=
MIA_INSTAGRAM_ACCOUNT_ID=
MIA_INSTAGRAM_GRAPH_HOST=graph.instagram.com
MIA_INSTAGRAM_GRAPH_VERSION=v26.0

# Composio: Gmail, Calendar, Sheets, LinkedIn profile, IG send/insights (sender=composio).
# Mia reads ONLY MIA_ prefix. COMPOSIO_API_KEY without MIA_ is ignored.
# User id MUST match Composio debug @user_id.
MIA_COMPOSIO_API_KEY=
MIA_COMPOSIO_USER_ID=
MIA_COMPOSIO_WEBHOOK_SECRET=

# KEEP
MIA_CALENDAR_TIMEZONE=Asia/Jerusalem

# --- Sheets: explicit owner-operational targets only; no Drive discovery ---
# Locked Contacts + Activity workbook. Live writes stay on this ID.
MIA_SHEETS_SPREADSHEET_ID=1HW8mnc9GFXraS6oG5VIxFcJvZq9gMDJBFRxY2mpVOhI
# Comma-separated IDs. The primary mirror ID above is included automatically.
MIA_SHEETS_ALLOWED_SPREADSHEET_IDS=

# --- Research: Firecrawl primary (SECRET). Apify fallback when Firecrawl is empty. ---
# Pin is apify/google-search-scraper via httpx run-sync. Not a model catalog. No apify-client.
MIA_FIRECRAWL_API_KEY=
MIA_APIFY_TOKEN=

# --- Google Search Console + GA4 + Sheets via Composio ---
# Empty GSC / GA4 pins can use the separately opt-in configured discovery path.
# Do not pin GOOGLE_ANALYTICS_SEND_EVENTS or GSC write tools.
MIA_GSC_SITE_URL=
MIA_GA4_PROPERTY_ID=

# --- Brain / owner agent (ADR-026). Empty locally fails closed. ---
# Production Secrets Manager mia/prod MUST set real model ids:
# MIA_OWNER_AGENT_MODEL, MIA_EXTRACTION_MODEL, MIA_EMBEDDING_MODEL.
# If MIA_OWNER_AGENT_MODEL is blank, the owner console falls through to
# MIA_SALES_MODEL (same id Ask Mia already uses). A dedicated tools-capable
# owner id is still better; leaving this blank is not a hard stop when sales
# is live. Knowledge ingest is CLI: uv run mia-ingest-knowledge
MIA_OWNER_AGENT_MODEL=
MIA_OWNER_AGENT_FALLBACK_MODEL=
# Cross-provider last resort for owner agent + extraction (Gemini OpenAI-compat).
# Suggested: gemini-3.7-flash. Blank disables it.
MIA_OWNER_AGENT_GEMINI_MODEL=
MIA_OWNER_AGENT_MAX_STEPS=8
MIA_EXTRACTION_MODEL=
MIA_EMBEDDING_PROVIDER=openai
MIA_EMBEDDING_MODEL=
MIA_EMBEDDING_DIM=1536
MIA_MEMORY_ENABLED=true
MIA_MEMORY_WRITE_ENABLED=true
MIA_MEMORY_MAX_CONTEXT_CHARS=4000
MIA_MEMORY_WEIGHT_RELEVANCE=1.0
MIA_MEMORY_WEIGHT_RECENCY=0.5
MIA_MEMORY_WEIGHT_IMPORTANCE=0.3
MIA_KNOWLEDGE_SOURCES=llms-full.txt,llms.txt,pricing.md

# Experimental Composio discovery helper. Stay false: ports already list GSC/GA4/Sheets
# at request time (ADR-027). Do not turn this on for go-live.
MIA_COMPOSIO_DISCOVERY=false
MIA_WEBSITE_MEETING_FIRST=true
MIA_WEBSITE_INACTIVITY_MINUTES=30

# ALB 5xx pager. Empty = stamp refuses to page (fail closed). Production: SNS topic ARN.
# deploy/cloudwatch-alb-5xx.example.json AlarmActions uses this name when stamped.
MIA_ALB_5XX_SNS_TOPIC_ARN=

